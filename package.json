  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "prebuild": "rimraf dist",
    "build": "tsc --module commonjs && rollup -c rollup.config.mjs && typedoc --entryPointStrategy expand src --out docs",
    "start": "rollup -c rollup.config.mjs -w",
