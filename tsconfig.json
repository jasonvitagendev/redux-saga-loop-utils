{
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "ES2019",
    "module": "ES2015",
    "lib": ["ES2019", "DOM"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "declarationDir": "dist/types",
    "outDir": "dist/lib",
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "include": [
    "src"
  ]
}
