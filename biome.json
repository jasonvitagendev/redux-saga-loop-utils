{
	"$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
	"formatter": {
		"lineWidth": 100,
		"include": ["src/**/*.{ts,tsx}"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		},
		"include": ["src/**/*.{ts,tsx}"]
	},
	"organizeImports": {
		"enabled": true,
		"include": ["src/**/*.{ts,tsx}"]
	}
}
